# Copy to .env and fill in
PORT=4000

# Firebase project ID (default: khaas-store). Backend verifies Firebase ID tokens
# against Google's public certs — no service-account secret needed for login.
# FIREBASE_PROJECT_ID=khaas-store
# Optional: service account (only needed for future admin ops, not for login)
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json

# Legacy self-rolled OTP endpoints (default OFF — keep off, Firebase is the auth path)
# ALLOW_LEGACY_OTP=true
# Never reveal OTP codes in API responses (keep false / unset)
# DEV_OTP_REVEAL=false

# Set true when serving over HTTPS in production
# COOKIE_SECURE=true
